{
  "chat.line.hover": {
    "parts": {
      "chevron": {
        "poses": {
          "rest": { "x": 0, "brighten": 0 },
          "on": { "x": 1, "brighten": 1 }
        },
        "beats": {
          "on": {
            "to": "on",
            "duration": 160,
            "curve": "ease_out",
            "tracks": {
              "brighten": [{ "travel": "ease_out", "end": 0.4 }],
              "x": [{ "travel": "ease_out", "begin": 0.3 }]
            }
          },
          "off": { "to": "rest", "duration": 110, "delay": 30, "curve": "ease_out" }
        }
      },
      "words": {
        "poses": {
          "rest": { "x": 0 },
          "on": { "x": 3 }
        },
        "beats": {
          "on": {
            "to": "on",
            "duration": 200,
            "delay": 30,
            "curve": "spring"
          },
          "off": { "to": "rest", "duration": 110, "curve": "ease_out" }
        }
      }
    },
    "params": { "stagger_span": 50 }
  },
  "chat.line.appear": {
    "duration": 180,
    "curve": "ease_in_out",
    "params": { "rise": 7, "slide": 14, "follow_through": 6, "fade_lead": 0.58 }
  },
  "chat.row.move": {
    "duration": 180,
    "curve": "back_out"
  },
  "chat.row.appear": {
    "duration": 180,
    "curve": "ease_out"
  },
  "chat.window.area": {
    "duration": 180,
    "curve": "ease_in_out"
  },
  "chat.window.members": {
    "duration": 180,
    "curve": "ease_in_out"
  },
  "chat.jump.show": {
    "duration": 180,
    "curve": "ease_in_out"
  },
  "chat.toolbar.show": {
    "duration": 120,
    "curve": "ease_out",
    "params": { "rest": 150 }
  },
  "chat.feed.typing": {
    "duration": 180,
    "curve": "ease_out"
  },
  "chat.scrollbar.fade": {
    "follow": 0.12
  }
}
