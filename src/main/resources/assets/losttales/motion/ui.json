{
  "ui.button.lift": {
    "about": "A glyph button under the pointer: it dips, rises a pixel past its mark and settles; pressed it drops onto the surface; let go it springs back in three shrinking lobes; left it returns quicker than it rose.",
    "parts": {
      "glyph": {
        "poses": {
          "rest": { "y": 0 },
          "on": { "y": -1 },
          "pressed": { "y": 1 }
        },
        "beats": {
          "on": {
            "to": "on",
            "duration": 170,
            "curve": "ease_out",
            "from": {
              "rest": {
                "y": [
                  { "travel": "ease_out", "begin": 0.28 },
                  { "bump": 0.34, "end": 0.28 },
                  { "bump": -0.5, "begin": 0.28 }
                ]
              }
            }
          },
          "off": { "to": "rest", "duration": 110, "curve": "ease_out" },
          "press": { "to": "pressed", "duration": 55, "curve": "ease_out" },
          "release": {
            "duration": 260,
            "curve": "ease_out",
            "tracks": {
              "y": [
                { "travel": "ease_out", "end": 0.3333 },
                { "ring": -1, "lobes": 3 }
              ]
            }
          }
        }
      }
    },
    "params": { "turn": 0, "min_press": 90 }
  },
